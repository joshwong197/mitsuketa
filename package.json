{
  "name": "mitsuketa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:export-viewer && vite",
    "build": "npm run build:export-viewer && vite build",
    "preview": "vite preview",
    "property": "node --env-file=.env utils/property.cli.ts",
    "check:memorials": "node utils/memorials.check.ts",
    "check:tiles": "node utils/tiles.check.ts",
    "check:lds": "tsx utils/lds.check.ts",
    "check:property-audit": "tsx utils/propertyAudit.check.ts",
    "check:browser": "playwright test",
    "check:nzbn-link": "esbuild services/resolveEntityNzbn.selftest.ts --bundle --format=cjs --platform=node --log-level=warning | node",
    "check": "npm run check:memorials && npm run check:lds && npm run check:nzbn-link && npm run check:property-audit && npm run check:property-access",
    "build:graph-bundle": "esbuild mcp/templates/graph-bundle.entry.ts --bundle --format=iife --minify --target=es2020 --outfile=mcp/templates/graph-bundle.js --log-level=info",
    "build:export-viewer": "esbuild export-viewer.entry.tsx --bundle --format=iife --minify --target=es2020 --outfile=public/export-viewer.js --log-level=info && tailwindcss -i export-viewer.css -o public/export-viewer.css --minify",
    "property:user": "node utils/property.pw.ts",
    "check:property-access": "tsx utils/propertyAccess.check.ts && tsx utils/stripeWebhook.check.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2",
    "@clerk/react": "^6.15.2",
    "@dagrejs/dagre": "^1.1.8",
    "@fontsource/shippori-mincho": "^5.2.8",
    "@fontsource/zen-kaku-gothic-new": "^5.2.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.2.0",
    "lucide-react": "^0.562.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reactflow": "^11.11.4",
    "stripe": "^22.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.34",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.6.10",
    "@vitejs/plugin-react": "^5.0.0",
    "cytoscape": "^3.33.4",
    "cytoscape-dagre": "^3.0.0",
    "cytoscape-expand-collapse": "^4.1.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
