# api.business.govt.nz subscription keys, used by the dev API middleware
# (vite-api-plugin.ts) to emulate api/proxy.ts locally. In production these
# are set as Vercel environment variables instead — this file only matters
# for `npm run dev`.
ORG_NZBN_KEY=
ORG_COMPANIES_KEY=
ORG_DISQUALIFIED_KEY=
ORG_INSOLVENCY_KEY=

# Property search (api/property.ts) — LINZ Title Register.
#
# LINZ_API_KEY is a LINZ Data Service key. The titles/owners/memorials layers it
# reads are RESTRICTED personal data under the LINZ Licence for Personal Data.
#
# AUTH — per-user credentials, one variable each:
#
#   PROPERTY_PW_<SLUGGED EMAIL> = scrypt$<salt>$<hash>
#
# Mint one with:  npm run property:user -- someone@fbu.com
# The slug uppercases the address and collapses every run of non-alphanumerics
# to an underscore, so niteshni.swami@fbu.com becomes
# PROPERTY_PW_NITESHNI_SWAMI_FBU_COM. Sign in with the full address.
#
# One variable per person is what makes a reset safe: adding, resetting or
# revoking someone touches exactly that person's variable, and because the
# session is signed with their stored hash, a reset signs out only them.
#
# Passwords are never stored — only the scrypt hash — so the variable does not
# have to be marked Sensitive to be safe from disclosure, and losing a password
# means minting a new one rather than looking the old one up.
#
# PROPERTY_PASS is the legacy single shared password. It still works when NO
# PROPERTY_PW_* variable exists, and is ignored entirely once one does —
# otherwise it would be a standing bypass around per-user revocation.
#
# LINZ_API_KEY plus at least one credential must be set, or /api/property returns
# 503 and the feature is unreachable. That is deliberate: it fails closed.
LINZ_API_KEY=
PROPERTY_PASS=
# PROPERTY_PW_SOMEONE_FBU_COM=scrypt$...$...
