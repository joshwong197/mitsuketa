# api.business.govt.nz subscription keys, used by the dev API middleware
# (vite-api-plugin.ts) to emulate api/proxy.ts locally. In production these
# are set as Vercel environment variables instead — this file only matters
# for `npm run dev`.
ORG_NZBN_KEY=
ORG_COMPANIES_KEY=
ORG_DISQUALIFIED_KEY=
ORG_INSOLVENCY_KEY=

# Property search (api/property.ts) — LINZ Title Register.
#
# LINZ_API_KEY is a LINZ Data Service key. The titles/owners/memorials layers it
# reads are RESTRICTED personal data under the LINZ Licence for Personal Data.
#
# PROPERTY_PASS is the shared password for the team. It also derives the session
# signing key, so changing it signs everyone out — which is the point.
#
# Both must be set or /api/property returns 503 and the feature is unreachable.
# That is deliberate: this endpoint fails closed, never open.
LINZ_API_KEY=
PROPERTY_PASS=
